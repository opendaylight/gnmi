        "id": 9229
      },
      "writtenOn": "2026-11-23T10:07:19Z",
      "side": 1,
      "message": "Dependencies are now read with revision-dates first, then pinned versions, then by name, and a skipped different requirement is logged.",
      "parentUuid": "4e7b57d8_e6921676",
      "revId": "4de3a9308f0b7adbb7dfb0c6a5b8da0b2caf206f",
      "serverId": "7fc14799-209e-464c-9743-7a06c2c21a81"
